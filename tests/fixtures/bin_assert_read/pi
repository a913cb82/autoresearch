#!/usr/bin/env python3
"""Assert the pi argv matches the read-tool contract, then succeed."""

import sys

a = sys.argv[1:]
if "--tools" in a:
    tools = a[a.index("--tools") + 1].split(",")
    assert set(tools) == {"read_approved", "read"}, a
    assert "--no-mcp" in a, a
    assert "-e" in a, a
    assert "-nt" not in a, a
else:
    assert "-nt" in a, a
print("ok")
